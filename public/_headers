# Versioned files (always linked as ?v=<build>), so a new release fetches fresh copies
/static/site.css
  Cache-Control: public, max-age=31536000, immutable
/static/site.js
  Cache-Control: public, max-age=31536000, immutable
/static/admin.css
  Cache-Control: public, max-age=31536000, immutable
/static/admin.js
  Cache-Control: public, max-age=31536000, immutable
# Logos, hero photos and icons: a day fresh, then refreshed in the background
/static/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/static/manifest.webmanifest
  Cache-Control: public, max-age=86400
